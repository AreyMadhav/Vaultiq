# Example environment variables for Personal File Explorer
# Copy to `.env` and update values before running

# Strong password to access the web UI
ACCESS_PASSWORD=changeme_replace_with_strong_password

# Host and port the server should bind to
# Use 0.0.0.0 to allow LAN/VPN access, or 127.0.0.1 for local-only
HOST=0.0.0.0
PORT=3000

# Session lifetime in hours (optional, server default may apply)
SESSION_HOURS=12

# Max upload size in megabytes (optional)
MAX_UPLOAD_MB=200

# Logging verbosity (optional): error, warn, info, debug
LOG_LEVEL=info
