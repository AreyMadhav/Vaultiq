# Example environment variables for Vaultiq
# Copy to `.env` and update values before running

# Optional legacy fallback login for a single shared password.
# Omit this if you use only per-user accounts.
ACCESS_PASSWORD=changeme_replace_with_strong_password

# Host and port the server should bind to
# Use 0.0.0.0 to allow LAN/VPN access, or 127.0.0.1 for local-only
HOST=0.0.0.0
PORT=3000

